{
  "name": "sap-fiori-timesheet-mcp",
  "version": "0.5.0",
  "description": "CLI + MCP server for the BearingPoint xflow (SAP Fiori) timesheet apps",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/e2e/**\"",
    "test:e2e": "vitest run test/e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli/run.ts",
    "mcp": "tsx src/mcp/run.ts",
    "prepare": "node scripts/build.mjs"
  },
  "keywords": [
    "sap",
    "fiori",
    "timesheet",
    "mcp",
    "cli",
    "bearingpoint",
    "xflow"
  ],
  "author": "Jane Doe",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.5.0",
    "@types/tough-cookie": "^4.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "playwright": "^1.63.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.5.4"
  },
  "type": "module",
  "bin": {
    "sap-fiori-timesheet-mcp": "bin/xflow-timesheet-mcp.js",
    "xflow-timesheet": "bin/xflow-timesheet.js",
    "xflow-timesheet-mcp": "bin/xflow-timesheet-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "scripts/build.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arno-vel-bept/sap-fiori-timesheet-mcp.git"
  },
  "homepage": "https://github.com/arno-vel-bept/sap-fiori-timesheet-mcp#readme",
  "bugs": {
    "url": "https://github.com/arno-vel-bept/sap-fiori-timesheet-mcp/issues"
  }
}
