# Copy this file to .env (or export these in your shell profile) and adjust as needed.
# xflow-timesheet reads these at startup; none are required to have a default —
# the tool works against any SAP Fiori deployment of the Standard/Multiproject
# timesheet apps, not just the one below.

# Fiori launchpad URL of your SAP system. This example points at BearingPoint's
# own internal "xflow" portal (the system this tool was originally built
# against); replace it with your organization's own Fiori launchpad URL.
XFLOW_LAUNCHPAD_URL=https://xflow.bearingpoint.com/fiori/shells/abap/FioriLaunchpad.html#Shell-home

# Where the SAP session cookies are cached after signing in.
# Default: ~/.config/xflow-timesheet/session.json
#XFLOW_SESSION_FILE=

# Persistent browser profile that remembers the identity-provider (Entra) sign-in,
# so an expired SAP session is renewed silently — no form, no 2FA — for as long as
# the identity provider remembers the browser. Keep it on a local, encrypted disk;
# it holds live session cookies. Default: ~/.config/xflow-timesheet/profile
#XFLOW_PROFILE_DIR=

# Playwright browser channel: "chromium" (bundled, default) or "chrome" (the real
# installed Google Chrome). Some identity providers throttle automation-flavoured
# Chromium; switch to chrome if the silent refresh is blocked.
#XFLOW_BROWSER_CHANNEL=chromium

# Non-interactive login credentials. For the CLI, prefer leaving these unset
# and entering them at the prompt instead. For the MCP server, set them here
# (in the MCP client config's "env" block) to let an agent call the
# login_start tool with no arguments — it reads them from here automatically.
# Either way, a 2FA code (if your tenant requires one) is still requested live
# via login_submit_otp / login_wait, since it changes every time.
#XFLOW_EMAIL=
#XFLOW_PASSWORD=

# SAP client and logon language, if your system needs a specific one.
#XFLOW_SAP_CLIENT=006
#XFLOW_LANGUAGE=EN
